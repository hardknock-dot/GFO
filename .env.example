# ORBIT Resource Management Portal (ORMP) Environment Variables

# Base URL for the FastAPI backend
VITE_API_URL=http://localhost:8000/api/v1

# Application Name
VITE_APP_NAME="ORBIT Resource Management Portal"

# Default selected company/tenant code
VITE_COMPANY=lam-research

# Whether to fallback to local JSON data when API is offline (true/false)
VITE_ENABLE_LOCAL_DATA=true

# Enable verbose console logging of API calls and interceptors (true/false)
VITE_ENABLE_LOGGING=true

# Application Version
VITE_APP_VERSION=1.0.0
